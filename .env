# ---------- Telegram (free, no trial expiry, no card needed) ----------
# 1. Message @BotFather on Telegram, send /newbot, follow prompts.
#    BotFather gives you a token that looks like: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=8735961986:AAF9HuamWOFo6zaFW5-RdRFWTD72gEtr3e8
# 2. Send any message to your new bot from your own Telegram account.
# 3. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser
#    and find "chat":{"id": ...} in the JSON response -- that number is your chat ID.
TELEGRAM_CHAT_ID=6512431953

# ---------- Anthropic (Claude API) ----------
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ---------- App config ----------
# SQLite file path (relative or absolute)
DB_PATH=flights.db

# Alert threshold in INR
PRICE_DROP_THRESHOLD_INR=1000

# Date range to track (YYYY-MM-DD, inclusive)
TRACK_START_DATE=2027-01-10
TRACK_END_DATE=2027-02-20

# Comma-separated ORIGIN:DEST pairs (IATA codes)
ROUTES=BOM:SYD,DEL:SYD,BLR:SYD

# Currency requested from Google Flights (INR recommended)
CURRENCY=INR

# Seconds to sleep between each Google Flights scrape (avoid rate limiting)
REQUEST_DELAY_SECONDS=3

# Max retry attempts per fare fetch
MAX_RETRIES=3

# Hour (24h, server local time) the daily job runs
DAILY_JOB_HOUR=6
DAILY_JOB_MINUTE=0

# Hour (24h) the Monday weekly digest runs (after the daily job)
WEEKLY_JOB_HOUR=8
WEEKLY_JOB_MINUTE=0
